# ---------------------------------------------------------------------------
# CrystOD: what stays out of the public repository
# ---------------------------------------------------------------------------

# internal development log
DEVELOPMENT.md

# research data and working directories (not part of the released package)
phonon_band/
matsym/
wannier90/
iso/
crystod_260814/
doc_260814/
CrystOD_claude/
.claude/
CrystOD_memo_*.pdf
irrep_table.xlsx
# a scratch run left at the top level.  Anchored with "/": a bare filename
# matches at every depth, which also hid the tracked documentation embed
# doc/_static/embed/MolOD_XYZ_NH3.html
/MolOD_XYZ_NH3.html
PLAN.md
PLAN_260706.md
TechnicalReport.md
MO_DIAGRAM_PRIOR_ART.md
.DS_Store

# built documentation: rebuilt by sphinx / the docs workflow
doc/_build/

# generated example outputs (the inputs next to them are kept)
example/**/org/
example/**/*.html
example/**/*.pdf
example/**/*.chk
example/**/*.csv

# packaging artifacts (rebuilt by `python -m build`) and editor/backup leftovers
__pycache__/
dist/
build/
*.egg-info/
.gitignore_org
*.bak
*.bak-*

# local debugging material (contains other people's paths and logs)
260824_debug/

# automatic PySCF checkpoints (crystod --diagram --pyscf writes CHK_{formula}.chk)
CHK_*.chk

# internal notes, reports and decision records (Japanese working documents)
/markdown/
# dated working directories at the top level: bug reports, theory notes,
# label maps, decision notes (YYMMDD_name/, e.g. 260930_CrystOD_bug-report/)
/2[0-9][0-9][0-9][0-9][0-9]_*/
# research surveys and material studies that are not part of the package
/HIF_survey/
/LSNO/
/lawsonite/
/others/
/hysteresis/
# scratch outputs of commands run at the top level
/CrystOD_*.html
/CrystOD_*.txt
/MolOD_*.html
# tool caches
.ruff_cache/

# example debugging material that stays local: the untracked collection of
# reported structures (the tracked debug1_* ... debug8_* cases are separate
# and are used by the test suite) and a generated coupling table
example/23_symmetry_mode/debug/
example/test_POSCARs/CrystOD_*_coupling.txt

# VASP pseudopotentials: the VASP licence does not allow redistribution
# (example/test_pyscf/BAND/POTCAR is tracked: it leaves with `git rm --cached`)
POTCAR

# reference material from external services, kept local pending a decision
# (already tracked: an entry here only takes effect after `git rm --cached`)
# /SUBGROUP/
# /DIRPRO/
# /AMPLIMODES/
