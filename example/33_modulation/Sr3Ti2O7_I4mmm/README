# The copy made by crystod-example has no phonopy_params.yaml (the package
# leaves it out; the CrystOD development tree keeps one here). Make it from the
# unit cell and FORCE_SETS with phonopy 4 (with phonopy 4.3.0 it is that file
# byte for byte; phonopy-init also writes phonopy_disp.yaml, SPOSCAR and
# POSCAR-001 ... POSCAR-010):
phonopy-init -d -c 139_PPOSCAR_Sr3Ti2O7 --dim 4 4 4
phonopy phonopy_disp.yaml --sp
# (phonopy before version 4, where -c moved to phonopy-init, makes it in one
# command:  phonopy --sp -c 139_PPOSCAR_Sr3Ti2O7 --dim="4 4 4")

crystod-phonon --modulation --yaml phonopy_params.yaml --qpoint 0 0 0.5

