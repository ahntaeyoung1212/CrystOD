# Show the star of k (symmetry-equivalent arms of a k point)

crystod --star-of-k -c ../test_POSCARs/221_PPOSCAR_ScF3 --kpoint 0.5 0.5 0

 ### Inputed cell was converted into primitive cell. ###

 * Space group *
 Pm-3m (221)

 * k point (primitive) *
 M [0.5, 0.5, 0.0]

 * Star of k *
 |G| = 48, |G_k| = 16, |star of k| = 3
 arm 1: k = [+0.5, +0.5, +0]   (representative: 1)
 arm 2: k = [+0.5, +0, +0.5]   (representative: 3^+_111)
 arm 3: k = [+0, +0.5, +0.5]   (representative: 2_101)



# k-point labels are accepted as well
crystod --star-of-k -c ../test_POSCARs/221_PPOSCAR_ScF3 --kpoint R

 ### Inputed cell was converted into primitive cell. ###

 * Space group *
 Pm-3m (221)

 * k point (primitive) *
 R [0.5, 0.5, 0.5]

 * Star of k *
 |G| = 48, |G_k| = 48, |star of k| = 1
 arm 1: k = [+0.5, +0.5, +0.5]   (representative: 1)
