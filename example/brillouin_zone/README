# Plot the Brillouin zone for the relevant POSCARs
crystod-bz -c ../test_POSCARs/227_PPOSCAR_Si
crystod-bz -c ../test_POSCARs/221_PPOSCAR_ScF3
crystod-bz -c ../test_POSCARs/139_PPOSCAR_Sr3Ti2O7

# Plot the Brillouin zones for cubic and rhombohedral-like ScF3 
crystod-bz -c ../test_POSCARs/221_PPOSCAR_ScF3 --trans-mat="0 1 2   -1 0 2   1 -1 2"
crystod-bz -c ../test_POSCARs/225_PPOSCAR_NaCl --trans-mat="-1 1 1   1 -1 1    1 1 -1"

