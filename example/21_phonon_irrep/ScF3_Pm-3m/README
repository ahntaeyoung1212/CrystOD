# Generate yaml file that shows irreps for phonons using FORCE_SETS
crystod-phonon --irreps --dim 4 4 4 -c 221_PPOSCAR_ScF3

# Generate yaml file that shows irreps for phonons using FORCE_CONSTANTS
crystod-phonon --irreps --dim 4 4 4 -c 221_PPOSCAR_ScF3 --readfc

# Additionally label the irreps at the midpoints of the seekpath k-path
# segments (symmetry lines; ISO-IR labels); this writes phonon_irreps_all.yaml
# instead of phonon_irreps.yaml, so both surveys coexist here
crystod-phonon --irreps --dim 4 4 4 -c 221_PPOSCAR_ScF3 --all-irreps
